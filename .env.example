# Get from @BotFather in Telegram
BOT_TOKEN=1234567890:AAAA-replace-with-your-real-token

# Get from https://aistudio.google.com/app/apikey  (free)
GEMINI_API_KEY=AIza-replace-with-your-key

# OPTIONAL: URL of your deployed Mini App (the React site)
WEBAPP_URL=

# OPTIONAL: your Telegram user id (numeric). Only this user can run /admin commands
ADMIN_ID=

# OPTIONAL: cache TTL for AI responses in minutes
CACHE_TTL_MIN=20
